# Copiar a .env y completar los valores. NUNCA subir .env al repositorio.

# --- Base de datos (SQL Server) ---
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_DATABASE=RentaCarDB
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Puerto del host para el contenedor SQL Server (1433 suele estar ocupado por un SQL local).
MSSQL_HOST_PORT=14330

# --- API ---
NODE_ENV=development
API_PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=10
MAX_DOC_MB=10

# --- Correo (dev: Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=RentaCarDB <no-reply@rentacar.cl>
MAILPIT_WEB_PORT=8026

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api
