# Copiar a .env para desarrollo local (el valor real no se versiona).
# En Docker, estas variables llegan desde el .env raíz vía docker-compose.

NODE_ENV=development
API_PORT=3000

DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_DATABASE=RentaCarDB
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=10
MAX_DOC_MB=10

# Correo (dev con Mailpit en localhost:1025; bandeja en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=RentaCarDB <no-reply@rentacar.cl>
